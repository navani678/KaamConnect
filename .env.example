# ==============================================================================
# KaamConnect AI — Root Environment Example
# ==============================================================================
# Copy this to .env or configure client and server .env files separately.

# Server settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/kaamconnect?retryWrites=true&w=majority

# Authentication
JWT_SECRET=kaamconnect_jwt_super_secret_dev_key_2026_hackathon
JWT_EXPIRES_IN=7d

# Cloudinary (Image & Video Uploads)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz_123

# Client (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_USE_MOCKS=false
