    {
      "name": "Workers & Discovery",
      "item": [
        {
          "name": "Update Worker Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{workerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"professions\": [\"electrician\"],\n  \"specializations\": [\"wiring\", \"fans\", \"MCB repair\"],\n  \"bio\": \"Experienced residential electrician with 8 years experience in Warangal.\",\n  \"experienceYears\": 8,\n  \"rateType\": \"daily\",\n  \"rate\": 900,\n  \"serviceRadiusKm\": 20,\n  \"location\": {\n    \"lat\": 17.9689,\n    \"lng\": 79.5941\n  },\n  \"addressText\": \"Hanamkonda Chowrasta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workers/me",
              "host": ["{{baseUrl}}"],
              "path": ["workers", "me"]
            }
          }
        },
        {
          "name": "Browse Workers Nearby",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workers?profession=electrician&lat=17.9689&lng=79.5941&maxDistanceKm=15",
              "host": ["{{baseUrl}}"],
              "path": ["workers"],
              "query": [
                { "key": "profession", "value": "electrician" },
                { "key": "lat", "value": "17.9689" },
                { "key": "lng", "value": "79.5941" },
                { "key": "maxDistanceKm", "value": "15" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profession\": \"electrician\",\n  \"title\": \"Install 3 ceiling fans and fix MCB switch\",\n  \"description\": \"Need complete fan wiring and MCB switch replacement in 3 bedrooms.\",\n  \"media\": [],\n  \"location\": {\n    \"lat\": 17.9710,\n    \"lng\": 79.5980\n  },\n  \"addressText\": \"Near Kazipet Railway Station\",\n  \"budgetMin\": 3000,\n  \"budgetMax\": 5000,\n  \"preferredDate\": \"2026-10-18T10:00:00.000Z\",\n  \"preferredTimeSlot\": \"morning\",\n  \"estimatedDuration\": {\n    \"value\": 1,\n    \"unit\": \"days\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('jobId', json.data.job._id || json.data.job.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get AI Matches for Job",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/matches",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}", "matches"]
            }
          }
        }
      ]
    },
